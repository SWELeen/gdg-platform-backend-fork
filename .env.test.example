# Dedicated Supabase test project only. Copy to .env.test.local.
# Never use a production or shared development Supabase project.
# Enter the test project reference and every production/shared-dev project ref.
SUPABASE_TEST_PROJECT_REF=REPLACE_WITH_DEDICATED_TEST_PROJECT_REF
SUPABASE_FORBIDDEN_PROJECT_REFS=REPLACE_WITH_PRODUCTION_REF,REPLACE_WITH_SHARED_DEVELOPMENT_REF

# Copy the PostgreSQL connection URI from this test project's Supabase Connect panel.
# Prefer Direct (port 5432) when reachable; otherwise use Session pooler (port 5432).
# Do not use Transaction pooler (port 6543) for this persistent Node/Prisma test runner.
# Keep the password URL-encoded. The placeholder below is not a working credential.
SUPABASE_TEST_DATABASE_URL="postgresql://postgres:[URL_ENCODED_TEST_DB_PASSWORD]@db.[TEST_PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
